<?xml version="1.0"?>
<package format="3">
  <name>lunabotics_autonomy</name>
  <version>0.1.0</version>
  <description>ROS 2 Humble perception and autonomy nodes for the UHCL NASA Lunabotics rover.</description>
  <maintainer email="maintainer@example.com">UHCL Lunar Hawks</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <export><build_type>ament_python</build_type></export>
<exec_depend>nav_msgs</exec_depend></package>
