<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lunabotics_rover">
  <xacro:property name="wheel_r" value="0.1524"/><xacro:property name="wheel_w" value="0.10"/>
  <link name="base_link"><inertial><mass value="40"/><origin xyz="0 0 0"/><inertia ixx="2.6" ixy="0" ixz="0" iyy="2.9" iyz="0" izz="3.3"/></inertial><visual><origin xyz="0 0 0.26"/><geometry><box size="0.87 0.75 0.32"/></geometry></visual><collision><origin xyz="0 0 0.26"/><geometry><box size="0.87 0.75 0.32"/></geometry></collision></link>
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}"><visual><geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry><origin rpy="1.5708 0 0"/></visual><collision><geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry><origin rpy="1.5708 0 0"/></collision></link>
    <joint name="${name}_joint" type="continuous"><parent link="base_link"/><child link="${name}"/><origin xyz="${x} ${y} 0.1524" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  </xacro:macro>
  <xacro:wheel name="wheel_fl" x="0.28" y="0.40"/><xacro:wheel name="wheel_fr" x="0.28" y="-0.40"/><xacro:wheel name="wheel_rl" x="-0.28" y="0.40"/><xacro:wheel name="wheel_rr" x="-0.28" y="-0.40"/>
  <link name="conveyor"><visual><origin xyz="0.52 0 0.53" rpy="0 -0.78 0"/><geometry><box size="0.68 0.50 0.10"/></geometry></visual></link><joint name="conveyor_joint" type="fixed"><parent link="base_link"/><child link="conveyor"/></joint>
  <link name="rear_bucket"><visual><origin xyz="-0.40 0 0.53"/><geometry><box size="0.32 0.60 0.45"/></geometry></visual></link><joint name="rear_bucket_joint" type="fixed"><parent link="base_link"/><child link="rear_bucket"/></joint>
  <link name="lidar_link"><visual><geometry><cylinder radius="0.05" length="0.05"/></geometry></visual></link><joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0.15 0 0.70"/></joint>
  <link name="camera_link"><visual><geometry><box size="0.05 0.08 0.05"/></geometry></visual></link><joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.43 0 0.60"/></joint>
  <gazebo reference="base_link"><plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so"><ros><namespace>/</namespace></ros><left_joint>wheel_fl_joint</left_joint><left_joint>wheel_rl_joint</left_joint><right_joint>wheel_fr_joint</right_joint><right_joint>wheel_rr_joint</right_joint><wheel_separation>0.75</wheel_separation><wheel_diameter>0.3048</wheel_diameter><max_wheel_torque>20</max_wheel_torque><command_topic>cmd_vel</command_topic><odometry_topic>odom</odometry_topic><odometry_frame>odom</odometry_frame><robot_base_frame>base_link</robot_base_frame></plugin></gazebo>
  <gazebo reference="lidar_link"><sensor type="ray" name="rplidar"><update_rate>10</update_rate><ray><scan><horizontal><samples>720</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.05</min><max>18.0</max><resolution>0.01</resolution></range></ray><plugin name="laser" filename="libgazebo_ros_ray_sensor.so"><ros><remapping>~/out:=scan</remapping></ros><output_type>sensor_msgs/LaserScan</output_type><frame_name>lidar_link</frame_name></plugin></sensor></gazebo>
  <gazebo reference="camera_link"><sensor type="camera" name="rgb_camera"><update_rate>20</update_rate><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image></camera><plugin name="camera" filename="libgazebo_ros_camera.so"><ros><namespace>/camera</namespace></ros><camera_name>front</camera_name><frame_name>camera_link</frame_name></plugin></sensor></gazebo>
</robot>
