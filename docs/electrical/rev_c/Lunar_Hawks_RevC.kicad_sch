(font(size 1 1))))(pin "1"(uuid "234505bf-4e84-4dfe-b199-8204abac6823"))(pin "2"(uuid "f68f7ad6-deab-4fcc-9bca-788e00c7272b"))(pin "3"(uuid "eff68429-b205-4643-9f18-18a4d1883d43"))(pin "4"(uuid "8d472784-bc83-4a38-ad54-f3e7037aa5b7"))(instances(project "Lunar_Hawks_RevC"(path "/235b11ec-d697-4670-a4e6-a4a86b6f62ae"(reference "J24")(unit 1)))))(text "Engineering system wiring draft. Module ports are logical, NOT connector pin assignments.\nSelect real modules, protection ratings and contactor coil suppression before fabrication.\nIsolated UART: no MOTOR_GND to COMPUTE_GND connection. Verify USB shields do not bypass isolation.\nActuator synchronization, limit switches, driver input thresholds and watchdog remain design gates." (at 20 750 0)(effects(font(size 2 2))(justify left top))(uuid "437c00e4-373e-42a9-b809-36b7e6db5550")))