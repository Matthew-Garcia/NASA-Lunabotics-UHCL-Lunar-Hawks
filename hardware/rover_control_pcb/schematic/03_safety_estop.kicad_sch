  (text "MOTION_ENABLE must default inactive during power-up, reset, brownout, watchdog trip, or firmware failure." (exclude_from_sim no) (at 20 29 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "31934670-cfc5-4b5f-8424-3520ef92cdd0"))
