<?xml version="1.0"?>
<sdf version="1.6">
  <world name="lunabotics_arena">
    <include><uri>model://sun</uri></include>
    <physics type="ode"><gravity>0 0 -9.81</gravity><real_time_update_rate>1000</real_time_update_rate></physics>
    <scene><ambient>0.55 0.55 0.55 1</ambient><background>0.06 0.06 0.08 1</background></scene>
    <model name="arena_floor"><static>true</static><link name="floor"><collision name="c"><geometry><box><size>12 8 0.10</size></box></geometry></collision><visual name="v"><geometry><box><size>12 8 0.10</size></box></geometry><material><ambient>0.42 0.38 0.31 1</ambient><diffuse>0.52 0.47 0.38 1</diffuse></material></visual></link></model>
    <!-- Low boundary walls -->
    <model name="north_wall"><static>true</static><pose>0 4 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>12 0.12 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>12 0.12 0.5</size></box></geometry></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -4 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>12 0.12 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>12 0.12 0.5</size></box></geometry></visual></link></model>
    <model name="east_wall"><static>true</static><pose>6 0 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.12 8 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.12 8 0.5</size></box></geometry></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-6 0 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.12 8 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.12 8 0.5</size></box></geometry></visual></link></model>
    <!-- Excavation region -->
    <model name="excavation_zone"><static>true</static><pose>-1.5 0 0.08 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>4.0 4.8 0.08</size></box></geometry><material><ambient>0.56 0.48 0.35 1</ambient><diffuse>0.65 0.57 0.42 1</diffuse></material></visual><collision name="c"><geometry><box><size>4.0 4.8 0.08</size></box></geometry></collision></link></model>
    <!-- Four disposal goal posts; arranged as a rectangular bay. -->
    <model name="goal_post_4.5_-1.45"><static>true</static><pose>4.5 -1.45 0.9 0 0 0</pose><link name="post"><collision name="c"><geometry><cylinder><radius>0.07</radius><length>1.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.07</radius><length>1.8</length></cylinder></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>
    <model name="goal_post_4.5_1.45"><static>true</static><pose>4.5 1.45 0.9 0 0 0</pose><link name="post"><collision name="c"><geometry><cylinder><radius>0.07</radius><length>1.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.07</radius><length>1.8</length></cylinder></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>
    <model name="goal_post_5.35_-1.45"><static>true</static><pose>5.35 -1.45 0.9 0 0 0</pose><link name="post"><collision name="c"><geometry><cylinder><radius>0.07</radius><length>1.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.07</radius><length>1.8</length></cylinder></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>
    <model name="goal_post_5.35_1.45"><static>true</static><pose>5.35 1.45 0.9 0 0 0</pose><link name="post"><collision name="c"><geometry><cylinder><radius>0.07</radius><length>1.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.07</radius><length>1.8</length></cylinder></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual></link></model>
    <model name="dump_bay_floor"><static>true</static><pose>4.925 0 0.06 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>0.85 2.9 0.06</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual></link></model>
  </world>
</sdf>
